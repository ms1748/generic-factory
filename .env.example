# Copy to .env next to docker-compose.yml, then `chmod 600 .env`. Never commit .env.
# Only the first block is required. Everything after it is optional and off until set.
# docs/quickstart.md walks through each part.

# ---- Required ---------------------------------------------------------------------------------------

# The repos whose issue queues the factory works (owner/name, comma-separated), the primary first: its
# .factory.yml sets the lanes and schedule. Each must be in the GitHub App's installation. Once you save
# the list on the dashboard (Settings › Install), the dashboard's list wins over this.
FACTORY_PROJECTS=your-name/your-repo

# GitHub App (recommended): comments and PRs show as <app>[bot]. The key is the app's .pem, base64 on one
# line (`base64 -w0 app.pem`). The IDs are on the app's settings page and its installation's URL.
GH_APP_ID=
GH_APP_INSTALLATION_ID=
GH_APP_PRIVATE_KEY_B64=
# Or, to try it out without an app: a fine-grained personal access token for the repos above.
# GH_TOKEN=

# From `claude setup-token` (uses your Claude plan; lasts a year).
CLAUDE_CODE_OAUTH_TOKEN=

# The git identity on the agents' commits (PRs and comments are the app's).
FACTORY_GIT_NAME=Your Name
FACTORY_GIT_EMAIL=you@users.noreply.github.com

# ---- Install settings (also on the dashboard: Settings › Install) ---------------------------------

# The dashboard's public address (used for the webhook URL and in agents' notes).
# FACTORY_URL=https://factory.example.com
# The GitHub App's former slugs, if it was renamed (its current one is read from GitHub): their comments
# count as the agents' in the Activity view.
# FACTORY_APP_SLUG=my-factory
# The primary repo's issue the dashboard's Stop button labels `factory-stop`.
# FACTORY_STOP_ISSUE=1
# CI check names that ran on your own test machines (a regular expression), for the Done line.
# FACTORY_DEVICE_CHECKS=test box|device
# The host of your project's PR previews behind Cloudflare Access (the reviewer opens them).
# FACTORY_PREVIEW_HOST=myproject.pages.dev
# Older names of the agents' comment marker (`<!-- name -->`, comma-separated), if comments already on
# GitHub carry one from before a rename. `<!-- factory -->` always counts.
# FACTORY_LEGACY_MARKERS=old-factory
# Schedules' time zone when the project's .factory.yml doesn't set one (default UTC).
# FACTORY_TIMEZONE=Europe/London

# ---- Webhooks, dashboard access ----------------------------------------------------------------------

# GitHub App webhooks: the same secret as in the app's settings (`openssl rand -hex 32`). Without it,
# owner replies still resume PR sessions, found by polling every 5 minutes instead of at once.
WEBHOOK_SECRET=
# A Cloudflare Tunnel that makes your dashboard address reach the dispatcher.
# CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel

# The dashboard needs a sign-in (docs/quickstart.md, "Securing the dashboard"). Either the built-in one:
# a password hash and/or a token from `node src/hash-password.ts` (`--token` for the token), then /login.
# FACTORY_PASSWORD_HASH=
# FACTORY_DASHBOARD_TOKEN=
# FACTORY_COOKIE_SECURE=0      # only over plain HTTP on a network that encrypts by itself (a tailnet)
# FACTORY_SESSION_HOURS=168
# FACTORY_BIND=                # the address to listen on; every interface when empty
# Or Cloudflare Access: requests through the tunnel must carry a valid Access token for this
# application (Zero Trust > Access > Applications > the app > Overview: "Application Audience (AUD) Tag";
# the team domain is under Settings > Custom pages). With neither, the dashboard only opens with
# FACTORY_LAN_OPEN=1, which is for a machine only you can reach (ignored once a password or token is set).
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# FACTORY_LAN_OPEN=1

# ---- Budget and limits -------------------------------------------------------------------------------

# The usage stops, the run time limit, the usage refresh and the auto-queue interval are on the dashboard
# (Settings › Limits). FACTORY_MAX_FIVE_HOUR, FACTORY_MAX_SEVEN_DAY, FACTORY_RUN_TIMEOUT_MIN,
# FACTORY_USAGE_REFRESH_MIN and FACTORY_AUTOQUEUE_EVERY_H still work as their starting values until saved there.
# Each run's machine share. Unset: 5 CPUs and 8 GB for one run, split evenly between runs at once (Parallel runs).
# FACTORY_AGENT_CPUS=5
# FACTORY_AGENT_MEMORY=8g
# The agent image (`docker compose build agent`) has Node, git, gh and Claude Code. 1 adds Rust (clippy,
# rustfmt) and Tauri's Linux build deps, for projects that need them. Rebuild the image after changing it.
# FACTORY_AGENT_TAURI=1
# Run agents in your own image instead, built FROM factory-agent with your project's tools (docs/quickstart.md).
# FACTORY_AGENT_IMAGE=factory-agent
# The host's docker group id (`getent group docker | cut -d: -f3`): the dispatcher joins it to start agent
# containers through the Docker socket (docs/deploy.md). Default 991.
# DOCKER_GID=991

# ---- Systems view (optional) -------------------------------------------------------------------------

# Machines' reporters (machines/reporters/) send their stats with this token, over your private network only
# (`openssl rand -hex 32`). Name the machines on Settings › Install › Machines.
# DEVICE_TOKEN=
# A Proxmox host from its API: a read-only token (Datacenter > Permissions > API Tokens, a user with the
# PVEAuditor role on /, privilege separation off). PVE_TOKEN is `user@realm!tokenid=secret`.
# PVE_URL=https://proxmox.lan:8006
# PVE_TOKEN=
# The host's CA (copy /etc/pve/pve-root-ca.pem into data/), so the self-signed certificate is trusted.
# PVE_CA_FILE=/app/data/pve-root-ca.pem
# Your site from Cloudflare: an API token with Account > Account Analytics: Read and
# Zone > Analytics: Read (your zone only). Nothing that can change anything.
# CF_API_TOKEN=
# CF_ACCOUNT_ID=
# CF_ZONE_ID=

# ---- Reports view (optional) -------------------------------------------------------------------------

# GlitchTip: a read-only API token. Its address and organization go on Settings › Install › Reports
# (or GLITCHTIP_URL and GLITCHTIP_ORG here).
# GLITCHTIP_TOKEN=

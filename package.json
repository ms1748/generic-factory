{
  "name": "generic-factory",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Runs Claude Code agents against a GitHub repo's issue queue from your own machine: builders, a reviewer and a dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dry-run": "node src/main.ts dry-run",
    "check": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "build:web": "vite build --config web/vite.config.js",
    "dev:web": "vite --config web/vite.config.js",
    "dev:fixture": "vite --config web/vite.config.js --mode fixture"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}

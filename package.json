{
  "name": "generic-factory",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Runs Claude Code agents against a GitHub repo's issue queue from your own machine: builders, a reviewer and a dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dry-run": "node src/main.ts dry-run",
    "check": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "build:web": "vite build --config web/vite.config.js",
    "dev:web": "vite --config web/vite.config.js",
    "dev:fixture": "vite --config web/vite.config.js --mode fixture",
    "check:web": "tsc --noEmit -p web"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
